{
  "name": "query-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n mock,app -c blue,green \"npm:mock\" \"npm:dev:app\"",
    "dev:app": "vite",
    "mock": "tsx watch mock-server/index.ts",
    "build": "tsc --noEmit && vite build && npm run check:offline",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:offline": "node scripts/check-offline.mjs",
    "lint": "eslint . && prettier --check ."
  },
  "dependencies": {
    "fomantic-ui-css": "^2.9.3",
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jquery": "^3.5.30",
    "@types/node": "^20.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
