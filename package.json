{
  "name": "query-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n mock,app -c blue,green \"npm:mock\" \"npm:dev:app\"",
    "dev:app": "vite",
    "mock": "tsx watch mock-server/index.ts",
    "build": "npm run typecheck && npm run build:app",
    "build:app": "tsc --noEmit -p tsconfig.app.json && vite build && npm run check:offline",
    "preview": "vite preview",
    "test": "vitest run --project app",
    "test:mock": "vitest run --project mock",
    "test:watch": "vitest --project app",
    "typecheck": "tsc --noEmit",
    "typecheck:mock": "tsc --noEmit -p tsconfig.mock.json",
    "check:offline": "node scripts/check-offline.mjs",
    "doc": "node scripts/doc-section.mjs",
    "servers": "node scripts/dev-servers.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "fomantic-ui-css": "^2.9.3",
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jquery": "^3.5.30",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "1.56.1",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
