# The API prefix: every request goes under it, the login and compliance flows
# included. It carries the API version, so moving to v2 is changing this line.
# No trailing slash. Override per deployment in .env.local or .env.production,
# or with an environment variable at build time (docs/ARCHITECTURE.md,
# "API contract").
VITE_API_BASE=/api/v1

# Dev only: the backend that `npm run dev` forwards the API prefix to. The
# default is the mock server, which listens on this URL's port. To develop
# against a real backend, point this at it (in .env.local, or as an
# environment variable) and run `npm run dev:app`. Not VITE_-prefixed, so it
# never reaches the bundle (docs/ARCHITECTURE.md, "Mock server").
DEV_BACKEND_URL=http://localhost:3001
